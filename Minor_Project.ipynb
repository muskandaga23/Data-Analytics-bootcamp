        "#Password Authentication System\n",
        "password=\"muskan\"\n",
        "for attempts in range(3,0,-1):\n",
        "    user_input=input(\"enter password:\")\n",
        "    if user_input == password:\n",
        "        print(\"access granted\")\n",
        "        break\n",
        "    else:\n",
        "        print(f\"wrong password! {attempts-1} attempts left\")"
      ]
